# Copy to .env.local (gitignored) to override the built-in defaults.

# Supabase (defaults point at the int project — see src/lib/config.ts)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_FUNCTIONS_URL=

# livecode-OPS logging (defaults to the int ingest — see src/lib/logger.ts)
# VITE_OPS_INGEST_URL=https://livecode-ops.vercel.app/api/logs/ingest
# VITE_OPS_INGEST_KEY=
# VITE_APP_VERSION=            # release tag attached to every logged event
# VITE_OPS_HEARTBEAT_MS=300000  # uptime heartbeat cadence in ms (0 disables it)
