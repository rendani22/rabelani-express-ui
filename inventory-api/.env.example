# Inventory Management API - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# APPLICATION
# ============================================================
ENVIRONMENT=development
PORT=8000

# ============================================================
# DATABASE
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# ============================================================
# AUTHENTICATION
# ============================================================
# JWT secret for signing tokens (use a strong, random value in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Token expiration in seconds (default: 1 hour)
JWT_EXPIRATION=3600

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# EXTERNAL SERVICES (Optional)
# ============================================================
# Email notifications
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Cloud storage for images
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

